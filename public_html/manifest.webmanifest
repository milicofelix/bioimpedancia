{
    "id": "/app",
    "name": "Vita Scan — Análise Clínica Biológica",
    "short_name": "Vita Scan",
    "description": "Área operacional Vita Scan para clientes, avaliações e relatórios de composição corporal.",
    "lang": "pt-BR",
    "start_url": "/app",
    "scope": "/app",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "any",
    "background_color": "#f5fafc",
    "theme_color": "#087f98",
    "categories": ["health", "medical", "productivity"],
    "prefer_related_applications": false,
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "icons": [
        {
            "src": "/pwa/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/pwa/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ]
}
