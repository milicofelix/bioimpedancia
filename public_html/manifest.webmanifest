{
    "id": "/app",
    "name": "Ricosty Atendimento",
    "short_name": "Ricosty",
    "description": "Área operacional para clientes, avaliações e relatórios de bioimpedância.",
    "lang": "pt-BR",
    "start_url": "/app",
    "scope": "/app",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "portrait-primary",
    "background_color": "#fffaf6",
    "theme_color": "#ad3f5b",
    "categories": ["health", "medical", "productivity"],
    "prefer_related_applications": false,
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "icons": [
        {
            "src": "/pwa/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/pwa/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/pwa/icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
